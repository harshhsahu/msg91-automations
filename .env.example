# ====================================================================
# Panel
# ====================================================================
# Local port (default 3000). Optional tuning is commented out below.
PORT=3000

# RUNS_DIR=data/runs
# LIVE_CONCURRENCY=3
# DRY_RUN_DELAY_MS=1500
# DRY_RUN_WAIT_MS=180000

# ====================================================================
# viaSocket account (swap these to use a different viaSocket account)
# ====================================================================
# Currently a testing account. To switch: replace the four values (or run: npx -y viasocket-apps setup --no-open),
# restart, then click 'Set up receiver' in the panel. The receiver flow is created in the new account automatically
# (its id is kept in data/receiver.json, per account, not in this file). Old runs stay tied to the account they ran on.
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
VIASOCKET_AGENT_TOKEN=

# ====================================================================
# MSG91 test environment
# ====================================================================
# AUTH_KEY is sent as the 'authkey' header. BASE_URL has no trailing slash, e.g. https://test.msg91.com
MSG91_TEST_BASE_URL=https://test.msg91.com
MSG91_TEST_COMPANY_ID=
MSG91_TEST_AUTH_KEY=

# ====================================================================
# MSG91 stage environment
# ====================================================================
# AUTH_KEY is sent as the 'authkey' header. BASE_URL has no trailing slash, e.g. https://test.msg91.com
MSG91_STAGE_BASE_URL=
MSG91_STAGE_COMPANY_ID=
MSG91_STAGE_AUTH_KEY=

# ====================================================================
# MSG91 prod environment
# ====================================================================
# AUTH_KEY is sent as the 'authkey' header. BASE_URL has no trailing slash, e.g. https://test.msg91.com
MSG91_PROD_BASE_URL=
MSG91_PROD_COMPANY_ID=
MSG91_PROD_AUTH_KEY=
